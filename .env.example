# Copy to .env and fill in (`make install` does the copy). Never commit .env.
# Every variable here is read by packages/shared/src/receptionist_shared/config.py.
# Empty values are ignored, so the default from config.py applies.

# General
ENVIRONMENT=dev          # dev | test | prod
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# LLM + STT (main). Model names are chosen in Phase 1 from Groq's current list.
GROQ_API_KEY=
GROQ_LLM_MODEL=
GROQ_STT_MODEL=

# Backup LLM + eval judge
GEMINI_API_KEY=
GEMINI_MODEL=

# Offline fallbacks (local, CPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
FASTER_WHISPER_MODEL=small

# Provider selection
STT_PROVIDER=groq        # groq | faster_whisper
LLM_PROVIDER=groq        # groq | gemini | ollama
TTS_PROVIDER=kokoro      # kokoro | piper

# Text-to-speech voices (Phase 1)
KOKORO_VOICE=
PIPER_VOICE=

# Local services (docker-compose reads the POSTGRES_* / *_PORT values too)
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=receptionist
POSTGRES_DB=receptionist
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:5432/receptionist
REDIS_URL=redis://localhost:6379/0

# Our own services
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
AGENT_HOST=127.0.0.1
AGENT_PORT=7860

# Phase 4: owner auth. Generate with: openssl rand -hex 32
JWT_SECRET=

# Phase 4: record call audio to storage/ (callers hear a disclosure when on)
RECORD_CALLS=false

# Phase 3: Google Calendar service account (path to JSON key, kept out of git)
GOOGLE_SERVICE_ACCOUNT_FILE=

# Phase 8: WhatsApp Business Platform
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
