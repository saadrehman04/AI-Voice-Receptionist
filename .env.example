# Copy to .env and fill in (`make install` does the copy). Never commit .env.
# Every variable here is read by packages/shared/src/receptionist_shared/config.py.
# Empty values are ignored, so the default from config.py applies.

# General
ENVIRONMENT=dev          # dev | test | prod
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# LLM + STT (main). Free key: https://console.groq.com/keys
# Leave model names empty to use the defaults in config.py
# (llama-3.3-70b-versatile, whisper-large-v3-turbo).
GROQ_API_KEY=
GROQ_LLM_MODEL=
GROQ_STT_MODEL=

# Backup LLM + eval judge. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=            # default gemini-3.5-flash-lite

# Offline fallbacks (local, CPU)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=            # default llama3.2:3b
FASTER_WHISPER_MODEL=small

# Provider selection
STT_PROVIDER=groq        # groq | faster_whisper
LLM_PROVIDER=groq        # groq | gemini | ollama
TTS_PROVIDER=kokoro      # kokoro | piper

# Speech-to-text language: empty = auto-detect, or an ISO code like en / ur
STT_LANGUAGE=

# Text-to-speech voices (models download on first use to Pipecat's cache dir)
KOKORO_VOICE=            # default af_heart
PIPER_VOICE=             # default en_US-lessac-medium
PIPER_URDU_VOICE=        # default ur_PK-fasih-medium (or ur_PK-aegis_female-medium)

# Which business answers browser test calls (tenants/<slug>.yaml)
TENANTS_DIR=tenants
DEFAULT_TENANT=demo-salon

# Logs: JSON lines on stderr; per-turn latency records go to TURNS_LOG_PATH
LOG_JSON=true
TURNS_LOG_PATH=logs/turns.jsonl

# Local services (docker-compose reads the POSTGRES_* / *_PORT values too)
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=receptionist
POSTGRES_DB=receptionist
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:5432/receptionist
REDIS_URL=redis://localhost:6379/0

# Our own services
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
AGENT_HOST=127.0.0.1
AGENT_PORT=7860

# Owner login (dashboard). At least 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=

# Agent -> api shared secret (X-Agent-Token). At least 32 chars: openssl rand -hex 32
AGENT_API_TOKEN=

# Where tools read/write: memory (stub, no api needed) | api (real bookings via apps/api)
BOOKING_BACKEND=memory
# Calendar behind the api: fake (in-memory) | google (needs GOOGLE_SERVICE_ACCOUNT_FILE)
CALENDAR_PROVIDER=fake
HOLD_SECS=120

# Per-tenant knowledge base: <KB_DIR>/<tenant-slug>/*.md, searched with a local embedding model
KB_DIR=tenants/kb
EMBEDDINGS_ENABLED=true
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Record call audio (stereo WAV: caller left, agent right). Callers hear a recording + AI
# disclosure first when this is on.
RECORD_CALLS=false
STORAGE_DIR=storage

# Phase 3: Google Calendar service account (path to JSON key, kept out of git)
GOOGLE_SERVICE_ACCOUNT_FILE=

# Phase 8: WhatsApp Business Platform
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
